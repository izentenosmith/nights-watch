# Copy to .env and fill in. A source or channel is enabled when its variable is set.
# Upload to GitHub: gh secret set --env dev -f .env
# Every name starts with NW_: GitHub refuses secret names that start with GITHUB_.

# Model
NW_LLM_MODEL=anthropic:claude-sonnet-5-5
NW_ANTHROPIC_API_KEY=

# Sources (global endpoints; per-app scoping lives in catalog/)
NW_PROMETHEUS_URL=
NW_LOKI_URL=
NW_KUBECONFIG=
NW_GITHUB_TOKEN=

# Channels (global defaults; catalog/<app>.yaml can override per app)
NW_SLACK_WEBHOOK_URL=
NW_SLACK_MIN_SEVERITY=warning
NW_TEAMS_WEBHOOK_URL=
NW_TEAMS_MIN_SEVERITY=warning
NW_WHATSAPP_TOKEN=
NW_WHATSAPP_PHONE_ID=
NW_WHATSAPP_TO=
NW_WHATSAPP_MIN_SEVERITY=critical

# Per-app variables referenced by catalog/*.yaml
NW_KNOCK_KNOCK_WHATSAPP_TO=

# Runtime
NW_CATALOG_DIR=catalog
NW_MAX_CONCURRENT_INVESTIGATIONS=3
