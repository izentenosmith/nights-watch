# Copy to .env and fill in. A source or channel is enabled when its variable is set.
# Upload to GitHub: gh secret set --env dev -f .env
# Every name starts with NW_: GitHub refuses secret names that start with GITHUB_.

# Model
NW_LLM_MODEL=anthropic:claude-sonnet-5-5
NW_ANTHROPIC_API_KEY=

# Sources (global endpoints; per-app scoping lives in catalog/)
NW_PROMETHEUS_URL=
NW_LOKI_URL=
NW_KUBECONFIG=
NW_GITHUB_TOKEN=

# Channels (global defaults; catalog/<app>.yaml can override per app)
NW_SLACK_WEBHOOK_URL=
NW_SLACK_MIN_SEVERITY=warning
NW_TEAMS_WEBHOOK_URL=
NW_TEAMS_MIN_SEVERITY=warning
NW_WHATSAPP_TOKEN=
NW_WHATSAPP_PHONE_ID=
NW_WHATSAPP_TO=
NW_WHATSAPP_MIN_SEVERITY=critical
# A template approved in Meta Business Manager. Its body takes three parameters, in
# order: {{1}} severity, {{2}} app, {{3}} alert title.
NW_WHATSAPP_TEMPLATE=
NW_WHATSAPP_TEMPLATE_LANG=

# Per-app variables referenced by catalog/*.yaml. Each one must be set, or the startup
# stops: NW_KNOCK_KNOCK_WHATSAPP_TO is required while catalog/knock-knock.yaml names it.
NW_KNOCK_KNOCK_WHATSAPP_TO=

# Runtime
NW_CATALOG_DIR=catalog
# Incidents: a new alert of the same rule for the same app joins the open incident if it arrives
# within this many seconds of that incident's latest alert. Keep it above group_interval (5m).
NW_GROUP_WINDOW=900
# An alert already in an incident stays with it while re-sent within this many seconds; past that
# its resolve is taken as lost. Keep it above repeat_interval (4h default, 12h in kube-prometheus).
NW_ALERT_STALE_AFTER=86400
NW_DB_PATH=data/nightswatch.sqlite
# Where people reach Night's Watch: every message links to <this>/runs/<id>.
NW_PUBLIC_URL=http://localhost:8000
NW_MAX_CONCURRENT_INVESTIGATIONS=3
